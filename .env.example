# ---------------------------------------------------------------------------
# All in One Auto — environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser; everything else
# is server-only (validated in src/lib/env/server.ts).
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details shown in the footer (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Supabase --------------------------------------------------------------
# Project Settings → API. Publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Maps --------------------------------------------------------------------
# MapLibre style URL. Leave empty to use OpenFreeMap (development only).
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Stripe Billing (Phase 6) -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="All in One Auto <no-reply@example.com>"

# --- Open Charge Map (EV charging import) -----------------------------------
# Free key: https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY=

# --- Scheduled jobs ----------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -hex 32`
CRON_SECRET=

# --- Rate limiting (production) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry ------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
